DATABASE_URL="postgresql://billow:billow-password@localhost:5432/billow?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Where uploaded files are written. Defaults to /data/uploads, which is the
# volume the container mounts — on a dev host that path does not exist and
# every upload fails, so point it somewhere local.
BILLOW_STORAGE_DIR="../../.uploads"
