{
  "name": "@billow/web",
  "version": "0.1.19",
  "private": true,
  "portless": {
    "name": "billow",
    "script": "dev:app"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev",
    "build": "pnpm --filter @billow/db db:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:local": "sh scripts/dev-local.sh",
    "dev:setup": "sh scripts/dev-local.sh --setup-only",
    "db:up": "docker compose -f ../../docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f ../../docker-compose.dev.yml down",
    "db:logs": "docker compose -f ../../docker-compose.dev.yml logs -f postgres",
    "db:generate": "pnpm --filter @billow/db db:generate",
    "db:migrate": "pnpm --filter @billow/db db:migrate",
    "db:seed": "pnpm --filter @billow/db db:seed"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/api-key": "1.6.25",
    "@billow/db": "workspace:*",
    "@billow/shadcn": "workspace:*",
    "@hookform/resolvers": "^5.5.1",
    "@scalar/api-reference-react": "^0.9.59",
    "better-auth": "~1.6.25",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@billow/eslint-config": "workspace:*",
    "@billow/tailwind-config": "workspace:*",
    "@billow/typescript-config": "workspace:*",
    "@billow/vitest-config": "workspace:*",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
