{
  "name": "@billow/web",
  "version": "0.1.3",
  "private": true,
  "portless": {
    "name": "billow",
    "script": "dev:app"
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev",
    "build": "pnpm --filter @billow/db db:generate && next build --webpack",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:local": "sh scripts/dev-local.sh",
    "dev:setup": "sh scripts/dev-local.sh --setup-only",
    "db:up": "docker compose -f ../../docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f ../../docker-compose.dev.yml down",
    "db:logs": "docker compose -f ../../docker-compose.dev.yml logs -f postgres",
    "db:generate": "pnpm --filter @billow/db db:generate",
    "db:migrate": "pnpm --filter @billow/db db:migrate",
    "db:seed": "pnpm --filter @billow/db db:seed",
    "db:reset": "pnpm --filter @billow/db db:reset"
  },
  "dependencies": {
    "@1password/save-button": "^1.3.0",
    "@base-ui/react": "^1.7.0",
    "@billow/auth": "workspace:*",
    "@billow/crypto": "workspace:*",
    "@billow/db": "workspace:*",
    "@billow/email": "workspace:*",
    "@billow/shadcn": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@scalar/api-reference-react": "^0.9.63",
    "better-auth": "~1.7.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@billow/tailwind-config": "workspace:*",
    "@billow/typescript-config": "workspace:*",
    "@billow/vitest-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
