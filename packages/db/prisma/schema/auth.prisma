// Accounts, sessions and credentials. Owned by @billow/auth: keep this file
// in step with that package, and audit the two together.

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  emailVerified   Boolean     @default(false)
  image           String?
  username        String?     @unique
  displayUsername String?
  twoFactorEnabled Boolean    @default(false)
  role            String?
  banned          Boolean?    @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sessions        Session[]
  accounts        Account[]
  twoFactors      TwoFactor[]
  apiKeys         Apikey[]
  uploads         Upload[]
  userProfiles    UserProfile[]
  clientCompanies ClientCompany[]
  invoices        Invoice[]
  vaultEntry      VaultEntry?
  keyset          UserKeyset?
  onboarding      UserOnboarding?

  @@map("user")
}

/// The wrapped forms of one user's data key — the key field-level encryption
/// will use. No column here yields that key on its own: each is the data key
/// sealed under a secret the server never stores, either the account password
/// or the recovery key issued at signup. Two arms exist so that changing a
/// password re-wraps 32 bytes instead of re-encrypting every row, and so that
/// a forgotten password is recoverable rather than fatal.
///
/// Sensitive, and never returned by any endpoint or included in a backup:
/// holding a wrap is precisely what makes an offline guessing attack against a
/// weak password possible. The salts are not secret by design — they are here
/// because they are meaningless apart from the wrap they belong to.
///
/// Not itself encrypted at the field level: this model *is* the encryption
/// mechanism, and encrypting it would need a key that does not exist yet.
model UserKeyset {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  passwordSalt                String
  dataKeyWrappedByPassword    String
  /// Null until onboarding issues a recovery key. It is minted there rather
  /// than at sign-up because it can only ever be shown once: it needs a page
  /// that displays it, confirms it by re-entry, and can re-issue it until the
  /// user says they have written it down.
  recoverySalt                String?
  dataKeyWrappedByRecoveryKey String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// The one-time steps that must happen before a user's data can be encrypted.
///
/// Internal: it records that events occurred and when, holds no key material,
/// and discloses nothing beyond account activity.
///
/// Timestamps rather than booleans, because "did they" and "when" are both
/// worth answering and null is an honest "not yet". Generating a recovery key
/// and confirming it was written down are separate columns deliberately —
/// only the second means the user can actually recover, and a checkbox would
/// record a click rather than possession.
model UserOnboarding {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  recoveryKeyGeneratedAt DateTime?
  recoveryKeySavedAt     DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Experimental per-user encrypted payload. `ciphertext` contains its KDF
/// parameters, salt, IV, authentication tag, and encrypted bytes — never the
/// user-supplied vault key or plaintext. It is deliberately one row per user:
/// this is a key-lifecycle probe, not the final encrypted-record model.
model VaultEntry {
  id         String   @id @default(cuid())
  userId     String   @unique
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Personal access tokens, managed by the @better-auth/api-key plugin.
/// Field set mirrors the plugin's own schema definition.
model Apikey {
  id                  String    @id @default(cuid())
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  permissions         String?
  metadata            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  /// referenceId is always a User id in this app, so removing an account also
  /// removes its keys rather than leaving credentials that still verify.
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([referenceId])
  @@map("apikey")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  impersonatedBy String?
  userId    String
  /// The user's data key, sealed under a random key that exists only in this
  /// session's httpOnly cookie. Storing it is safe because it is inert without
  /// that cookie, and it is what lets a server component reach the data key
  /// without the password and without the server holding anything usable at
  /// rest. Null for sessions predating the keyset and for API-key callers,
  /// which carry no cookie and so cannot decrypt.
  dataKeyWrappedBySessionKey String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Rate-limit counters, in the shape BetterAuth's database storage expects
/// (`key`, `count`, `lastRequest`). Also backs the limiter on this app's own
/// scrypt-bearing routes, which BetterAuth's limiter does not cover because it
/// only sees `/api/auth/*`.
///
/// Internal: counters and opaque bucket keys. A key can embed a user id or an
/// IP address, so it is not public, but it holds no credential or content.
///
/// Exists because in-memory counters reset on every restart, and this app
/// restarts on every update — briefly reopening the brute-force window each
/// time it is deployed.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
