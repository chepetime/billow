// The invoicing domain.

enum InvoiceStatus {
  DRAFT
  SENT
  APPROVED
  PAID
  TAX_RECEIPT
  TAX_RETURN
  DONE
  VOID
}

model UserProfile {
  id           Int           @id @default(autoincrement())
  displayName  String
  legalName    String
  email        String
  taxId        String?
  address      String
  department   String?
  manager      String?
  userId       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  bankAccounts BankAccount[]
  invoices     Invoice[]
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id                   Int         @id @default(autoincrement())
  userProfileId        Int
  label                String
  bankName             String
  bankAddress          String?
  bankPhone            String?
  accountHolderName    String
  accountHolderAddress String?
  accountNumber        String
  accountType          String?
  institutionNumber    String?
  transitNumber        String?
  routingNumber        String?
  swift                String?
  iban                 String?
  clabe                String?
  isDefault            Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  userProfile          UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  invoices             Invoice[]

  @@index([userProfileId])
}

model ClientCompany {
  id              Int       @id @default(autoincrement())
  name            String
  legalName       String?
  address1        String
  address2        String?
  cityStatePostal String
  country         String
  email           String
  attentionTo     String?
  notes           String?
  userId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  invoices        Invoice[]
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invoice {
  id              Int               @id @default(autoincrement())
  publicId        String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber   Int
  invoiceDate     DateTime
  status          InvoiceStatus     @default(DRAFT)
  sentAt          DateTime?
  approvedAt      DateTime?
  paidAt          DateTime?
  cfdiIssuedAt    DateTime?
  currency        String            @default("MXN")
  notes           String?
  userId          String?
  userProfileId   Int
  bankAccountId   Int
  clientCompanyId Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  userProfile     UserProfile       @relation(fields: [userProfileId], references: [id], onDelete: Restrict)
  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  clientCompany   ClientCompany     @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)
  lineItems       InvoiceLineItem[]
  revisions       InvoiceRevision[]
  documents       InvoiceDocument[]
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, invoiceNumber])
  @@index([invoiceDate])
  @@index([userId])
  @@index([status])
  @@index([userId, sentAt])
  @@index([userId, approvedAt])
  @@index([userId, paidAt])
  @@index([userId, cfdiIssuedAt])
  @@index([userProfileId])
  @@index([bankAccountId])
  @@index([clientCompanyId])
}

enum InvoiceDocumentKind {
  CFDI_XML
  CFDI_PDF
  PAYMENT_PROOF
  SIGNED_COPY
  OTHER
}

model InvoiceDocument {
  id        Int                 @id @default(autoincrement())
  invoiceId Int
  uploadId  String              @unique
  kind      InvoiceDocumentKind
  note      String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  invoice   Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  upload    Upload              @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, kind])
  @@index([invoiceId])
}

model InvoiceLineItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  description String
  note        String?
  quantity    Decimal  @db.Decimal(12, 2)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceRevision {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  revisionNumber Int
  editor         String
  summary        String
  payload        Json
  createdAt      DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, revisionNumber])
  @@index([invoiceId])
}

enum TaxPeriodDocumentKind {
  TAX_RETURN
  PAYMENT_CONFIRMATION
  OTHER
}

model TaxPeriod {
  id         Int                 @id @default(autoincrement())
  userId     String
  year       Int
  month      Int
  currency   String              @default("MXN")
  amountPaid Decimal?            @db.Decimal(12, 2)
  filedAt    DateTime?
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  documents  TaxPeriodDocument[]
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, filedAt])
  @@index([userId, paidAt])
}

model TaxPeriodDocument {
  id          Int                   @id @default(autoincrement())
  taxPeriodId Int
  uploadId    String                @unique
  kind        TaxPeriodDocumentKind
  note        String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  taxPeriod   TaxPeriod             @relation(fields: [taxPeriodId], references: [id], onDelete: Cascade)
  upload      Upload                @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@unique([taxPeriodId, kind])
  @@index([taxPeriodId])
}
