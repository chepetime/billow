// Installation-wide records: app metadata, registration policy, the error
// log and uploaded files.

model AppMetadata {
  id            Int      @id @default(autoincrement())
  appId         String   @unique
  name          String
  tagline       String
  version       String
  dockerImage   String
  repositoryUrl String?
  supportUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RegistrationSettings {
  id      Int     @id @default(1)
  enabled Boolean @default(false)
}

/// Outbound email configuration, set by an administrator in the UI rather
/// than the environment, because a self-hosted operator has no way to edit
/// container env vars without redeploying.
///
/// `apiKey` holds AES-256-GCM ciphertext (see packages/email/src/crypto.ts),
/// never the raw credential, and is never returned to a client. `apiKeyHint`
/// is the only part safe to display.
model EmailSettings {
  id          Int      @id @default(1)
  provider    String   @default("resend")
  apiKey      String?
  apiKeyHint  String?
  fromEmail   String?
  fromName    String?
  /// Optional canonical URL for links in emails. Normally the sending request's
  /// own origin is used, which is correct for whichever front door the user is
  /// on. Set this when that is wrong — e.g. the operator wants every emailed
  /// link to point at a Tailscale or Cloudflare hostname regardless of where
  /// the request came from. Never fall back to BETTER_AUTH_URL: it is
  /// deliberately the in-container localhost, which is a dead link in an inbox.
  publicUrl   String?
  /// When a test message last went out successfully. Stored credentials prove
  /// nothing on their own — the domain may be unverified, the key revoked, or
  /// the box may have no outbound route — so user-facing features that depend
  /// on email stay hidden until a real send has worked at least once. Cleared
  /// whenever the credentials or sender change, and when a live send fails.
  verifiedAt  DateTime?
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// A file attached to an account: avatar, image, PDF and so on. Bytes live on
/// the mounted uploads volume; only metadata is stored here. `storageKey` is
/// generated, never derived from the client's filename.
model Upload {
  id          String   @id @default(cuid())
  userId      String
  storageKey  String   @unique
  filename    String
  contentType String
  size        Int
  checksum    String
  kind        String   @default("attachment")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, kind])
}

model ErrorLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  context   String
  message   String
  stack     String?
  meta      Json?

  @@index([createdAt])
}
