{
  "name": "@billow/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./base/*": [
      "./src/base/*.tsx",
      "./src/base/*.ts"
    ],
    "./partials/*": [
      "./src/partials/*.tsx",
      "./src/partials/*.ts"
    ],
    "./providers/*": [
      "./src/providers/*.tsx",
      "./src/providers/*.ts"
    ],
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@billow/shadcn": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@billow/typescript-config": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^7.0.2"
  }
}
